# Groq API key for the LangGraph reasoning layer (Phase 3)
GROQ_API_KEY=

# SQLite DB file path (Phase 4). Defaults to backend/db/nemesis.db if unset.
NEMESIS_DB_PATH=backend/db/nemesis.db

# Allowed frontend origin(s) for CORS (comma-separated). Default: Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Kaggle credentials — not read from here; kaggle CLI expects ~/.kaggle/kaggle.json
