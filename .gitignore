# and embedding features on deploy without the 135 MB graph.
!backend/models/checkpoints/graphsage.pt

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Node
node_modules/
frontend/dist/
frontend/build/

# SQLite runtime DB
backend/db/*.db

# Env / secrets
.env

# Editor/OS
.DS_Store
.omc/

