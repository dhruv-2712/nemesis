# Data (large, licensed — never committed)
data/raw/*
data/processed/*
data/graphs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/graphs/.gitkeep

# Model checkpoints (large binaries)
backend/models/checkpoints/*
!backend/models/checkpoints/.gitkeep
